root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Java is formatted by Spotless (palantir-java-format); keep the editor in step with it.
[*.java]
max_line_length = 120

[*.{yml,yaml}]
indent_size = 4

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[{gradlew.bat,*.bat}]
end_of_line = crlf
